---
import SectionHead from './SectionHead.astro';
import { withBase, projectPath, type Lang } from '../i18n';
import type { Dictionary } from '../i18n/types';

interface Props {
  dict: Dictionary;
  lang: Lang;
}

const { dict, lang } = Astro.props;
const t = dict.projects;
const isRu = lang === 'ru';

const isUk = lang === 'uk';
const cats = {
  web: isUk ? 'Веб-проєкти' : isRu ? 'Веб-проекты' : 'Web Projects',
  mods: isUk ? 'Моди для ігор' : isRu ? 'Моды для игр' : 'Game Mods',
  all: isUk ? 'Усі роботи' : isRu ? 'Все работы' : 'All Works',
};

const counts = {
  web: t.items.filter(p => (p.category || 'web') === 'web').length,
  mods: t.items.filter(p => p.category === 'mods').length,
  all: t.items.length,
};
---

<section class="section" id="projects">
  <div class="container">
    <SectionHead num="02" label={t.label} heading={t.heading} headingAccent={t.headingAccent} />

    <!-- Filter Tabs (Web Projects is active by default) -->
    <div class="filter-tabs" role="tablist">
      <button class="tab active" data-filter="web" role="tab" aria-selected="true">
        <svg class="tab-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span>{cats.web}</span>
        <span class="tab-count">{counts.web}</span>
      </button>

      <button class="tab" data-filter="mods" role="tab" aria-selected="false">
        <svg class="tab-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="6" width="20" height="12" rx="3"></rect>
          <path d="M6 12h4m-2-2v4m7-2h.01m3 0h.01"></path>
        </svg>
        <span>{cats.mods}</span>
        <span class="tab-count">{counts.mods}</span>
      </button>

      <button class="tab" data-filter="all" role="tab" aria-selected="false">
        <svg class="tab-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span>{cats.all}</span>
        <span class="tab-count">{counts.all}</span>
      </button>
    </div>

    <!-- Projects List -->
    <div class="list" id="projects-list">
      {
        t.items.map((project, i) => {
          const isFlagship = project.slug === 'zoovix';
          const isDefaultHidden = (project.category || 'web') !== 'web';
          const projectScreens = (project.gallery && project.gallery.length > 0)
            ? project.gallery
            : (project.image ? [{ src: project.image, alt: project.title, title: project.title }] : []);
          const hasMultiScreens = projectScreens.length > 1;

          return (
            <article 
              class={`project ${isFlagship ? 'project--flagship' : ''}`} 
              data-reveal 
              data-category={project.category || 'web'}
              style={isDefaultHidden ? 'display: none;' : ''}
            >
              {project.details ? (
                <a 
                  href={projectPath(lang, project.slug)} 
                  class={`visual visual--${project.category || 'web'} visual--link ${project.slug === 'poezdato' ? 'visual--light-screen' : ''}`}
                  aria-label={`${t.caseLink}: ${project.title}`}
                >
                  {project.category === 'web' && (
                    <div class="browser-frame-bar" aria-hidden="true">
                      <div class="browser-dots">
                        <span class="browser-dot browser-dot--red" />
                        <span class="browser-dot browser-dot--yellow" />
                        <span class="browser-dot browser-dot--green" />
                      </div>
                      <div class="browser-url-pill">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <span>{project.slug === 'zoovix' ? 'zoovix.fun' : 'poizdato.net'}</span>
                      </div>
                    </div>
                  )}

                  <div class="visual-body">
                    {hasMultiScreens ? (
                      <div class="card-carousel" data-card-carousel data-total={projectScreens.length}>
                        <div class="card-carousel-track" data-card-track>
                          {projectScreens.map((screen, sIdx) => (
                            <div 
                              class={`card-carousel-slide ${sIdx === 0 ? 'is-active' : ''}`} 
                              data-card-slide={sIdx}
                            >
                              <img 
                                src={withBase(screen.src)} 
                                alt={screen.alt || project.title} 
                                loading={i === 0 && sIdx === 0 ? 'eager' : 'lazy'} 
                                draggable="false"
                                class="visual-img" 
                              />
                            </div>
                          ))}
                        </div>

                        <div class="card-carousel-bar">
                          <div class="card-timeline" role="tablist" aria-label="Screenshots">
                            {projectScreens.map((screen, sIdx) => (
                              <button 
                                type="button" 
                                class={`card-timeline-seg ${sIdx === 0 ? 'is-active' : ''}`} 
                                data-card-segment={sIdx}
                                aria-label={`Slide ${sIdx + 1}: ${screen.title || ''}`}
                              >
                                <span class="card-timeline-track">
                                  <span class="card-timeline-fill" />
                                </span>
                              </button>
                            ))}
                          </div>

                          <div class="card-nav-arrows">
                            <button 
                              type="button" 
                              class="card-nav-arrow card-nav-arrow--prev" 
                              data-card-prev 
                              title="Previous screenshot"
                              aria-label="Previous screenshot"
                            >
                              <svg width="11" height="11" viewBox="0 0 16 16" fill="none">
                                <path d="M10 13 5 8l5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </button>
                            <button 
                              type="button" 
                              class="card-nav-arrow card-nav-arrow--next" 
                              data-card-next 
                              title="Next screenshot"
                              aria-label="Next screenshot"
                            >
                              <svg width="11" height="11" viewBox="0 0 16 16" fill="none">
                                <path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </button>
                          </div>
                        </div>
                      </div>
                    ) : project.image ? (
                      <img src={withBase(project.image)} alt={`Preview of ${project.title}`} loading="lazy" class="visual-img" />
                    ) : (
                      <div class="placeholder" aria-hidden="true">
                        <span class="ph-index">{String(i + 1).padStart(2, '0')}</span>
                        <span class="ph-ring" />
                        <span class="ph-ring ph-ring--2" />
                      </div>
                    )}
                  </div>
                </a>
              ) : (
                <div class={`visual visual--${project.category || 'web'}`}>
                  <div class="visual-body">
                    {project.image ? (
                      <img src={withBase(project.image)} alt={`Preview of ${project.title}`} loading="lazy" class="visual-img" />
                    ) : (
                      <div class="placeholder" aria-hidden="true">
                        <span class="ph-index">{String(i + 1).padStart(2, '0')}</span>
                        <span class="ph-ring" />
                        <span class="ph-ring ph-ring--2" />
                      </div>
                    )}
                  </div>
                </div>
              )}

              <div class="info">
                <header class="head">
                  <span class="index">{String(i + 1).padStart(2, '0')}</span>
                  {isFlagship && (
                    <span class="flagship-badge">
                      {isUk ? 'ФЛАГМАНСЬКИЙ ПРОЄКТ' : isRu ? 'ФЛАГМАНСКИЙ ПРОЕКТ' : 'FLAGSHIP PROJECT'}
                    </span>
                  )}
                  {project.wip && <span class="wip">{t.wipBadge}</span>}
                  {project.category && (
                    <span class="cat-badge">
                      {project.category === 'mods' ? 'Unity Mod' : 'Web App'}
                    </span>
                  )}
                </header>

                <h3 class="name">{project.title}</h3>
                <p class="kind">{project.kind}</p>
                <p class="desc">{project.lede || (project as any).description}</p>

                <!-- Clean Metrics Row with Stylish SVG Icons -->
                {project.metrics && project.metrics.length > 0 && (
                  <div class="metrics-row" role="list">
                    {project.metrics.map((m) => {
                      const lbl = m.label.toLowerCase();
                      const isDl = lbl.includes('скачиван') || lbl.includes('download');
                      const isLike = lbl.includes('лайк') || lbl.includes('like');
                      const isLang = lbl.includes('язык') || lbl.includes('lang');
                      const isSource = lbl.includes('источник') || lbl.includes('source');
                      const isCoop = lbl.includes('мульти') || lbl.includes('co-op') || lbl.includes('multi');

                      return (
                        <div class="metric-badge" role="listitem">
                          {isDl && (
                            <svg class="metric-svg metric-svg--dl" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                              <polyline points="7 10 12 15 17 10"></polyline>
                              <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                          )}
                          {isLike && (
                            <svg class="metric-svg metric-svg--like" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                          )}
                          {isLang && (
                            <svg class="metric-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="12" r="10"></circle>
                              <line x1="2" y1="12" x2="22" y2="12"></line>
                              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                            </svg>
                          )}
                          {isSource && (
                            <svg class="metric-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                              <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                              <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                              <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                            </svg>
                          )}
                          {isCoop && (
                            <svg class="metric-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                              <circle cx="9" cy="7" r="4"></circle>
                              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                          )}
                          {!isDl && !isLike && !isLang && !isSource && !isCoop && (
                            <svg class="metric-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                          )}

                          <span class="metric-val">{m.value}</span>
                          <span class="metric-lbl">{m.label}</span>
                        </div>
                      );
                    })}
                  </div>
                )}

                <ul class="tech" role="list">
                  {project.tech.map((item) => (
                    <li class="chip">{item}</li>
                  ))}
                </ul>

                <div class="links">
                  {project.details && (
                    <a class="link link--case" href={projectPath(lang, project.slug)}>
                      {t.caseLink}
                      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path
                          d="M3 8h10M9 4l4 4-4 4"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  )}
                  {project.links.map((link) => (
                    <a class="link" href={link.url} target="_blank" rel="noopener noreferrer">
                      {link.label}
                      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path
                          d="M4 12 12 4M6 4h6v6"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  ))}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tabs .tab');
  const projects = document.querySelectorAll<HTMLElement>('.project[data-category]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const filter = tab.dataset.filter || 'web';

      projects.forEach((proj) => {
        const cat = proj.dataset.category;
        if (filter === 'all' || cat === filter) {
          proj.style.display = 'grid';
          proj.style.opacity = '1';
          proj.style.transform = 'translateY(0)';
        } else {
          proj.style.display = 'none';
        }
      });
    });
  });

  // Card Carousels with Real Grab-and-Drag & Story Progress
  const carousels = document.querySelectorAll<HTMLElement>('[data-card-carousel]');

  carousels.forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-card-track]');
    const slides = carousel.querySelectorAll<HTMLElement>('[data-card-slide]');
    const segments = carousel.querySelectorAll<HTMLButtonElement>('[data-card-segment]');
    const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-card-prev]');
    const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-card-next]');
    const link = carousel.closest('a');
    const total = slides.length;
    if (total <= 1 || !track) return;

    let activeIdx = 0;
    let timer: number | null = null;
    let isDragging = false;
    let didDrag = false;
    let startX = 0;
    let deltaX = 0;

    const setSlide = (idx: number, animate = true) => {
      activeIdx = (idx + total) % total;
      if (animate) {
        track.style.transition = 'transform 0.5s cubic-bezier(0.25, 1, 0.35, 1)';
      } else {
        track.style.transition = 'none';
      }
      track.style.transform = `translate3d(-${activeIdx * 100}%, 0, 0)`;

      slides.forEach((s, i) => {
        s.classList.toggle('is-active', i === activeIdx);
      });

      segments.forEach((seg, i) => {
        seg.classList.remove('is-active', 'is-done', 'is-paused');
        const fill = seg.querySelector<HTMLElement>('.card-timeline-fill');
        if (fill) {
          fill.style.transition = '';
        }
        if (i < activeIdx) {
          seg.classList.add('is-done');
        } else if (i === activeIdx) {
          void seg.offsetWidth;
          seg.classList.add('is-active');
        }
      });
    };

    const startTimer = () => {
      stopTimer();
      setSlide(activeIdx);
      timer = window.setInterval(() => {
        setSlide(activeIdx + 1);
      }, 4500);
    };

    const stopTimer = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
      const activeSeg = segments[activeIdx];
      if (activeSeg) {
        activeSeg.classList.add('is-paused');
      }
    };

    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      setSlide(activeIdx - 1);
      startTimer();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      setSlide(activeIdx + 1);
      startTimer();
    });

    segments.forEach((seg, idx) => {
      seg.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        setSlide(idx);
        startTimer();
      });
    });

    // ── Mouse & Touch Grab & Drag ──
    const onPointerDown = (clientX: number) => {
      isDragging = true;
      didDrag = false;
      startX = clientX;
      deltaX = 0;
      stopTimer();
      carousel.classList.add('is-dragging');
      track.style.transition = 'none';
    };

    const onPointerMove = (clientX: number) => {
      if (!isDragging) return;
      deltaX = clientX - startX;
      if (Math.abs(deltaX) > 6) {
        didDrag = true;
      }
      const width = carousel.offsetWidth || 1;
      const pct = (deltaX / width) * 100;
      track.style.transform = `translate3d(calc(-${activeIdx * 100}% + ${pct}%), 0, 0)`;
    };

    const onPointerUp = () => {
      if (!isDragging) return;
      isDragging = false;
      carousel.classList.remove('is-dragging');
      const width = carousel.offsetWidth || 1;
      const threshold = width * 0.15;
      if (deltaX < -threshold) {
        setSlide(activeIdx + 1);
      } else if (deltaX > threshold) {
        setSlide(activeIdx - 1);
      } else {
        setSlide(activeIdx);
      }
      startTimer();
    };

    // Mouse events
    carousel.addEventListener('mousedown', (e) => {
      if ((e.target as HTMLElement).closest('.card-nav-arrows, .card-timeline')) return;
      onPointerDown(e.clientX);
    });

    window.addEventListener('mousemove', (e) => {
      if (isDragging) onPointerMove(e.clientX);
    });

    window.addEventListener('mouseup', () => {
      if (isDragging) onPointerUp();
    });

    // Touch events
    carousel.addEventListener('touchstart', (e) => {
      if ((e.target as HTMLElement).closest('.card-nav-arrows, .card-timeline')) return;
      onPointerDown(e.touches[0].clientX);
    }, { passive: true });

    carousel.addEventListener('touchmove', (e) => {
      if (isDragging) onPointerMove(e.touches[0].clientX);
    }, { passive: true });

    carousel.addEventListener('touchend', () => {
      if (isDragging) onPointerUp();
    }, { passive: true });

    // Suppress link click if user was dragging
    link?.addEventListener('click', (e) => {
      if (didDrag) {
        e.preventDefault();
        e.stopPropagation();
        didDrag = false;
      }
    }, true);

    const projectCard = carousel.closest('.project');
    if (projectCard) {
      projectCard.addEventListener('mouseenter', stopTimer);
      projectCard.addEventListener('mouseleave', startTimer);
    }

    startTimer();
  });
</script>

<style>
  /* Category Tabs */
  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
    margin-bottom: 3.5rem;
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    border: 1px solid var(--line-soft);
    background: var(--bg-elev);
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s var(--ease-out);
  }

  .tab:hover {
    border-color: var(--line);
    color: var(--ink);
    transform: translateY(-2px);
  }

  .tab.active {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }

  .tab.active .tab-icon {
    stroke: var(--bg);
  }

  .tab.active .tab-count {
    background: rgba(255, 255, 255, 0.18);
    color: var(--bg);
    border-color: transparent;
  }

  .tab-icon {
    flex-shrink: 0;
    stroke: currentColor;
    transition: stroke 0.2s;
  }

  .tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 99px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--muted);
    transition: all 0.2s;
  }

  .list {
    display: grid;
    gap: clamp(3.5rem, 8vw, 6rem);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .project:nth-child(even) .visual {
    order: 2;
  }

  /* ── Visual Container & Interactive Browser Framing ── */
  .visual {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    aspect-ratio: 4 / 3;
    background: var(--bg-elev);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    transition: transform 0.6s var(--ease-out), box-shadow 0.6s var(--ease-out), border-color 0.4s;
    isolation: isolate;
  }

  .visual--link {
    cursor: pointer;
    text-decoration: none;
  }

  .visual::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), transparent 35%, rgba(0, 0, 0, 0.1));
    opacity: 0.5;
    transition: opacity 0.6s var(--ease-out);
  }

  .project:hover .visual {
    transform: translateY(-6px);
    border-color: var(--line);
    box-shadow: 0 24px 48px -24px rgba(25, 23, 18, 0.25);
  }

  .project:hover .visual::after {
    opacity: 0;
  }

  .visual--web {
    aspect-ratio: 16 / 10;
    background: #0d0e12;
  }

  .visual--light-screen {
    background: #f4f6f4;
  }

  .browser-frame-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.85rem;
    background: rgba(25, 23, 18, 0.06);
    border-bottom: 1px solid var(--line-soft);
    position: relative;
