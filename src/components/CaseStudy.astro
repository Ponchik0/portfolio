---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getDict, homePath, projectPath, withBase, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const dict = getDict(lang);
const t = dict.projects;

const index = t.items.findIndex((p) => p.slug === slug);
const project = t.items[index];
const next = t.items[(index + 1) % t.items.length];
const hasNext = t.items.length > 1 && next.slug !== project.slug;
const cover = project.image ?? project.gallery?.[0]?.src;
const gallery = project.gallery ?? [];
---

<Base lang={lang} dict={dict} pageTitle={`${project.title} — ${dict.hero.name}`}>
  <Header lang={lang} dict={dict} sectionBase={homePath(lang)} projectSlug={project.slug} />

  <main class="case">
    <div class="container">
      <a class="back" href={`${homePath(lang)}#projects`}>
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M13 8H3M7 4 3 8l4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {t.caseBack}
      </a>

      <header class="head" data-reveal>
        <p class="meta">
          <span>{project.year}</span>
          <span class="dot" aria-hidden="true">·</span>
          <span>{project.kind}</span>
          {project.wip && <span class="wip">{t.wipBadge}</span>}
        </p>
        <h1 class="title">{project.title}</h1>
        <p class="lede">{project.lede}</p>

        {project.links.length > 0 && (
          <div class="links">
            {project.links.map((link) => (
              <a class="link" href={link.url} target="_blank" rel="noopener noreferrer">
                {link.label}
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M4 12 12 4M6 4h6v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            ))}
          </div>
        )}
      </header>

      {cover && (
        <div class="shot-wrapper" data-reveal>
          <div 
            class={`shot ${project.category === 'web' ? 'shot--browser' : ''}`}
            data-gallery-image={withBase(cover)}
            data-gallery-alt={project.title}
            data-gallery-title={project.title}
            data-gallery-caption={project.lede}
            role="button"
            tabindex="0"
            aria-label={`${t.caseGallery}: ${project.title}`}
          >
            {project.category === 'web' && (
              <div class="browser-bar" aria-hidden="true">
                <div class="browser-dots">
                  <span class="browser-dot browser-dot--red" />
                  <span class="browser-dot browser-dot--yellow" />
                  <span class="browser-dot browser-dot--green" />
                </div>
                <div class="browser-url">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                  <span>{project.slug === 'zoovix' ? 'https://zoovix.fun' : project.slug === 'poezdato' ? 'https://poizdato.net' : `https://${project.slug}.app`}</span>
                </div>
                <span class="browser-zoom-pill" title="Click to enlarge">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                </span>
              </div>
            )}
            <div class="shot-viewport">
              <img src={withBase(cover)} alt={project.title} loading="eager" />
            </div>
          </div>
        </div>
      )}

      {project.metrics.length > 0 && (
        <div class="metrics" data-reveal>
          {project.metrics.map((m) => (
            <div class="metric">
              <span class="metric-value">{m.value}</span>
              <span class="metric-label">{m.label}</span>
            </div>
          ))}
        </div>
      )}

      <div class="body">
        <section class="block" data-reveal>
          <h2 class="block-title">{t.caseAbout}</h2>
          <div class="prose">
            {project.details.intro.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </section>

        <section class="block" data-reveal>
          <h2 class="block-title">{t.caseFeatures}</h2>
          <ul class="features" role="list">
            {project.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </section>

        {gallery.length > 0 && (
          <section class="block gallery-block" data-reveal>
            <div class="gallery-heading-row">
              <h2 class="block-title">{t.caseGallery}</h2>
              <span class="gallery-count-pill">{gallery.length} screens</span>
            </div>

            <div class={`gallery-layout gallery-layout--${gallery.length}`}>
              {gallery.map((image, imageIndex) => (
                <figure class="gallery-card">
                  <div 
                    class="gallery-frame" 
                    role="button"
                    tabindex="0"
                    data-gallery-image={withBase(image.src)} 
                    data-gallery-alt={image.alt}
                    data-gallery-title={image.title || `${project.title} — Screen ${imageIndex + 1}`}
                    data-gallery-caption={image.caption || image.alt}
                    aria-label={`${image.title || image.alt} (Click to enlarge)`}
                  >
                    {project.category === 'web' && (
                      <div class="browser-bar browser-bar--card" aria-hidden="true">
                        <div class="browser-dots">
                          <span class="browser-dot browser-dot--red" />
                          <span class="browser-dot browser-dot--yellow" />
                          <span class="browser-dot browser-dot--green" />
                        </div>
                        <span class="browser-card-tag">{image.title || `Screen 0${imageIndex + 1}`}</span>
                      </div>
                    )}
                    <div class="gallery-img-box">
                      <img src={withBase(image.src)} alt={image.alt} loading="lazy" />
                    </div>
                    <span class="gallery-open-indicator" aria-hidden="true">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"></path>
                      </svg>
                    </span>
                  </div>

                  {(image.title || image.caption) && (
                    <figcaption class="gallery-caption">
                      {image.title && <h3 class="gallery-caption-title">{image.title}</h3>}
                      {image.caption && <p class="gallery-caption-text">{image.caption}</p>}
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>
          </section>
        )}

        <section class="block" data-reveal>
          <h2 class="block-title">{t.caseChallenges}</h2>
          <div class="challenges">
            {project.details.challenges.map((c) => (
              <article class="challenge">
                <h3 class="challenge-title">{c.title}</h3>
                <p class="challenge-text">{c.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="block" data-reveal>
          <h2 class="block-title">{t.caseStack}</h2>
          <div class="stack">
            {project.details.stack.map((group) => (
              <div class="stack-group">
                <h3 class="stack-name">{group.name}</h3>
                <ul class="tech" role="list">
                  {group.items.map((item) => (
                    <li class="chip">{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      </div>

      <nav class="foot-nav" aria-label={t.caseBack}>
        <a class="foot-back" href={`${homePath(lang)}#projects`}>{t.caseBack}</a>
        {hasNext && (
          <a class="foot-next" href={projectPath(lang, next.slug)}>
            <span class="foot-next-label">{t.caseNext}</span>
            <span class="foot-next-title">
              {next.title}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        )}
      </nav>
    </div>
  </main>

  <dialog class="lightbox" id="case-lightbox" aria-label={t.caseGallery}>
    <div class="lightbox-stage">
      <header class="lightbox-bar">
        <div class="lightbox-meta">
          <span class="lightbox-counter" id="lb-counter">1 / 1</span>
          <span class="lightbox-title-text" id="lb-title"></span>
        </div>
        <button class="lightbox-close-btn" id="lb-close" type="button" aria-label="Close modal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </header>

      <div class="lightbox-center">
        <button class="lightbox-arrow lightbox-arrow--prev" id="lb-prev" type="button" aria-label="Previous screenshot">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="lightbox-view">
          <img class="lightbox-image" id="lb-img" src="" alt="" />
        </div>

        <button class="lightbox-arrow lightbox-arrow--next" id="lb-next" type="button" aria-label="Next screenshot">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <footer class="lightbox-footer">
        <p class="lightbox-caption-text" id="lb-caption"></p>
      </footer>
    </div>
  </dialog>

  <Footer dict={dict} />
</Base>

<script>
  const lightbox = document.getElementById('case-lightbox') as HTMLDialogElement | null;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement | null;
  const lbTitle = document.getElementById('lb-title');
  const lbCaption = document.getElementById('lb-caption');
  const lbCounter = document.getElementById('lb-counter');
  const lbPrev = document.getElementById('lb-prev');
  const lbNext = document.getElementById('lb-next');
  const lbClose = document.getElementById('lb-close');

  const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-gallery-image]'));
  let currentIndex = 0;

  function showImage(index: number) {
    if (!triggers.length || !lightbox || !lbImg) return;
    currentIndex = (index + triggers.length) % triggers.length;
    const item = triggers[currentIndex];
    const src = item.dataset.galleryImage || '';
    const alt = item.dataset.galleryAlt || '';
    const title = item.dataset.galleryTitle || alt;
    const caption = item.dataset.galleryCaption || '';

    lbImg.src = src;
    lbImg.alt = alt;
    if (lbTitle) lbTitle.textContent = title;
    if (lbCaption) lbCaption.textContent = caption;
    if (lbCounter) lbCounter.textContent = `${currentIndex + 1} / ${triggers.length}`;

    if (lbPrev) lbPrev.style.display = triggers.length > 1 ? 'grid' : 'none';
    if (lbNext) lbNext.style.display = triggers.length > 1 ? 'grid' : 'none';
  }

  triggers.forEach((trigger, index) => {
    const handleOpen = () => {
      showImage(index);
      lightbox?.showModal();
    };
    trigger.addEventListener('click', handleOpen);
    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        handleOpen();
      }
    });
  });

  lbPrev?.addEventListener('click', (e) => {
    e.stopPropagation();
    showImage(currentIndex - 1);
  });
  lbNext?.addEventListener('click', (e) => {
    e.stopPropagation();
    showImage(currentIndex + 1);
  });
  lbClose?.addEventListener('click', () => lightbox?.close());

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) lightbox.close();
  });

  window.addEventListener('keydown', (e) => {
    if (!lightbox?.open) return;
    if (e.key === 'ArrowLeft') {
      showImage(currentIndex - 1);
    } else if (e.key === 'ArrowRight') {
      showImage(currentIndex + 1);
    }
  });
</script>

<style>
  .case {
    padding-top: clamp(6.5rem, 12vh, 9rem);
    padding-bottom: var(--section-gap);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--muted);
    transition: color 0.2s, gap 0.25s var(--ease-out);
  }
  .back:hover {
    color: var(--accent);
    gap: 0.75rem;
  }

  .head {
    max-width: 48rem;
    margin-top: 2.5rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
  }
  .meta .dot {
    color: var(--line);
  }
  .wip {
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .title {
    margin-top: 1rem;
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .lede {
    margin-top: 1.4rem;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.6;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 2rem;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: 0.95rem;
    border-bottom: 1.5px solid var(--line);
    padding-bottom: 0.2rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ── Featured Cover Shot ── */
  .shot-wrapper {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .shot {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    background: var(--bg-elev);
    display: flex;
    flex-direction: column;
    width: 100%;
    cursor: zoom-in;
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out), border-color 0.3s ease;
  }
  .shot:hover {
    transform: translateY(-4px);
    border-color: var(--line);
    box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.22);
  }
  .shot-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    transition: transform 0.6s var(--ease-out);
  }
  .shot:hover img {
    transform: scale(1.015);
  }

  /* ── Browser Mockup Header ── */
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1.1rem;
    background: rgba(25, 23, 18, 0.05);
    border-bottom: 1px solid var(--line-soft);
    position: relative;
    z-index: 2;
  }
  :root[data-theme='dark'] .browser-bar {
    background: rgba(255, 255, 255, 0.04);
  }
  .browser-bar--card {
    padding: 0.5rem 0.8rem;
  }
  .browser-dots {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .browser-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    opacity: 0.85;
  }
  .browser-dot--red { background: #ff5f56; }
  .browser-dot--yellow { background: #ffbd2e; }
  .browser-dot--green { background: #27c93f; }

  .browser-url {
    margin-left: auto;
    margin-right: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.85rem;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--line-soft);
    font-size: 0.75rem;
    font-family: var(--font-sans);
    color: var(--muted);
    letter-spacing: 0.02em;
    transform: translateX(-0.75rem);
  }
  .browser-card-tag {
    margin-left: auto;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .browser-zoom-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .shot:hover .browser-zoom-pill {
    color: var(--accent);
    transform: scale(1.1);
  }

  /* ── Metrics ── */
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: clamp(1.2rem, 3vw, 2rem);
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding: clamp(1.6rem, 4vw, 2.2rem) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .metric {
    display: grid;
    gap: 0.4rem;
  }
  .metric-value {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 2.8rem);
    line-height: 1;
    color: var(--accent);
  }
  .metric-label {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .body {
    display: grid;
    gap: clamp(3.5rem, 8vw, 5.5rem);
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
    max-width: 60rem;
  }

  /* ── Gallery Section ── */
  .gallery-block {
    margin: 1rem 0;
  }
  .gallery-heading-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.8rem;
  }
  .gallery-count-pill {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  .gallery-layout {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .gallery-layout--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .gallery-layout--3 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .gallery-layout--3 .gallery-card:first-child {
    grid-column: 1 / -1;
  }

  .gallery-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0;
  }

  .gallery-frame {
    position: relative;
    border-radius: 1.15rem;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    background: var(--bg-elev);
    display: flex;
    flex-direction: column;
    cursor: zoom-in;
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out), border-color 0.3s ease;
  }
  .gallery-frame:hover {
    transform: translateY(-4px);
    border-color: var(--line);
    box-shadow: 0 20px 40px -18px rgba(0, 0, 0, 0.2);
  }
  .gallery-img-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #0d0e12;
  }
  .gallery-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.5s var(--ease-out);
  }
  .gallery-frame:hover img {
    transform: scale(1.03);
  }

  .gallery-open-indicator {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    display: grid;
    width: 2.3rem;
    height: 2.3rem;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    opacity: 0;
    transform: translateY(0.35rem);
    transition: opacity 0.25s ease, transform 0.25s var(--ease-out);
    box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.3);
  }
  .gallery-frame:hover .gallery-open-indicator,
  .gallery-frame:focus-visible .gallery-open-indicator {
    opacity: 1;
    transform: none;
  }

  .gallery-caption {
    padding: 0 0.25rem;
  }
  .gallery-caption-title {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }
  .gallery-caption-text {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--muted);
  }

  /* ── Prose & Features ── */
  .block-title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.5rem, 3.2vw, 2rem);
    margin-bottom: 1.6rem;
    color: var(--ink);
  }

  .prose {
    display: grid;
    gap: 1.1rem;
  }
  .prose p {
    font-size: clamp(1rem, 1.6vw, 1.1rem);
    line-height: 1.75;
    color: var(--muted);
    max-width: 44rem;
  }

  .features {
    display: grid;
    gap: 0;
    padding: 0;
    list-style: none;
  }
  .features li {
    position: relative;
    padding: 1rem 0 1rem 1.8rem;
    border-top: 1px solid var(--line-soft);
    font-size: 1.02rem;
    line-height: 1.5;
    color: var(--ink);
  }
  .features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.45rem;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
  }

  .challenges {
    display: grid;
    gap: 1.2rem;
