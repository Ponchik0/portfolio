---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getDict, homePath, projectPath, withBase, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const dict = getDict(lang);
const t = dict.projects;

const index = t.items.findIndex((p) => p.slug === slug);
const project = t.items[index];
const next = t.items[(index + 1) % t.items.length];
const hasNext = t.items.length > 1 && next.slug !== project.slug;
const slides = (project.gallery && project.gallery.length > 0)
  ? project.gallery
  : (project.image ? [{ src: project.image, alt: project.title, title: project.title, caption: project.lede }] : []);
---

<Base lang={lang} dict={dict} pageTitle={`${project.title} — ${dict.hero.name}`}>
  <Header lang={lang} dict={dict} sectionBase={homePath(lang)} projectSlug={project.slug} />

  <main class="case">
    <div class="container">
      <a class="back" href={`${homePath(lang)}#projects`}>
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M13 8H3M7 4 3 8l4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {t.caseBack}
      </a>

      <header class="head" data-reveal>
        <p class="meta">
          <span>{project.year}</span>
          <span class="dot" aria-hidden="true">·</span>
          <span>{project.kind}</span>
          {project.wip && <span class="wip">{t.wipBadge}</span>}
        </p>
        <h1 class="title">{project.title}</h1>
        <p class="lede">{project.lede}</p>

        {project.links.length > 0 && (
          <div class="links">
            {project.links.map((link) => (
              <a class="link" href={link.url} target="_blank" rel="noopener noreferrer">
                {link.label}
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M4 12 12 4M6 4h6v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            ))}
          </div>
        )}
      </header>

      {slides.length > 0 && (
        <div class="case-carousel-wrapper" data-reveal>
          <div 
            class={`case-carousel ${project.category === 'web' ? 'case-carousel--browser' : ''}`}
            id="case-carousel"
            data-slides-count={slides.length}
          >
            {project.category === 'web' && (
              <div class="browser-bar" aria-hidden="true">
                <div class="browser-dots">
                  <span class="browser-dot browser-dot--red" />
                  <span class="browser-dot browser-dot--yellow" />
                  <span class="browser-dot browser-dot--green" />
                </div>
                <div class="browser-url">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                  <span>{project.slug === 'zoovix' ? 'https://zoovix.fun' : project.slug === 'poezdato' ? 'https://poizdato.net' : `https://${project.slug}.app`}</span>
                </div>
                <div class="browser-actions">
                  {slides.length > 1 && (
                    <span class="carousel-counter-badge" id="carousel-counter">
                      1 / {slides.length}
                    </span>
                  )}
                  <button 
                    type="button" 
                    class="browser-zoom-btn" 
                    id="carousel-zoom-btn" 
                    title={t.caseGallery || 'Open fullscreen'}
                    aria-label={t.caseGallery || 'Open fullscreen'}
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      <line x1="11" y1="8" x2="11" y2="14"></line>
                      <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                  </button>
                </div>
              </div>
            )}

            <!-- Viewport with slides -->
            <div class="carousel-stage" id="carousel-stage">
              <div class="carousel-track" id="carousel-track">
                {slides.map((s, idx) => (
                  <div 
                    class={`carousel-slide ${idx === 0 ? 'is-active' : ''}`}
                    data-slide-index={idx}
                    data-gallery-image={withBase(s.src)}
                    data-gallery-alt={s.alt}
                    data-gallery-title={s.title || project.title}
                    data-gallery-caption={s.caption || ''}
                    role="button"
                    tabindex="0"
                    aria-label={`${s.title || project.title} — click to zoom`}
                  >
                    <div class="carousel-img-container">
                      <img 
                        src={withBase(s.src)} 
                        alt={s.alt} 
                        loading={idx === 0 ? 'eager' : 'lazy'} 
                        draggable="false"
                        class="carousel-slide-img"
                      />
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Slide Info and Story Timeline Bar (NO CIRCLES!) -->
            {slides.length > 1 && (
              <div class="carousel-info-bar">
                <div class="carousel-info-text">
                  <h3 class="carousel-slide-title" id="carousel-slide-title">{slides[0]?.title || project.title}</h3>
                  {slides[0]?.caption && (
                    <p class="carousel-slide-caption" id="carousel-slide-caption">{slides[0]?.caption}</p>
                  )}
                </div>

                <div class="carousel-nav-group">
                  <div class="case-timeline" role="tablist" aria-label="Screenshots">
                    {slides.map((s, idx) => (
                      <button 
                        type="button" 
                        class={`case-timeline-seg ${idx === 0 ? 'is-active' : ''}`}
                        data-dot-index={idx}
                        role="tab"
                        aria-selected={idx === 0 ? 'true' : 'false'}
                        aria-label={`Slide ${idx + 1}: ${s.title || ''}`}
                      >
                        <span class="case-timeline-track">
                          <span class="case-timeline-fill" />
                        </span>
                        <span class="case-timeline-num">0{idx + 1}</span>
                      </button>
                    ))}
                  </div>

                  <div class="case-nav-arrows">
                    <button 
                      type="button" 
                      class="case-nav-btn case-nav-btn--prev" 
                      id="carousel-prev" 
                      title="Previous screenshot"
                      aria-label="Previous screenshot"
                    >
                      <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
                        <path d="M10 13 5 8l5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                    <button 
                      type="button" 
                      class="case-nav-btn case-nav-btn--next" 
                      id="carousel-next" 
                      title="Next screenshot"
                      aria-label="Next screenshot"
                    >
                      <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
                        <path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      {project.metrics.length > 0 && (
        <div class="metrics" data-reveal>
          {project.metrics.map((m) => (
            <div class="metric">
              <span class="metric-value">{m.value}</span>
              <span class="metric-label">{m.label}</span>
            </div>
          ))}
        </div>
      )}

      <div class="body">
        <section class="block" data-reveal>
          <h2 class="block-title">{t.caseAbout}</h2>
          <div class="prose">
            {project.details.intro.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </section>

        <section class="block" data-reveal>
          <h2 class="block-title">{t.caseFeatures}</h2>
          <ul class="features" role="list">
            {project.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </section>



        <section class="block" data-reveal>
          <h2 class="block-title">{t.caseChallenges}</h2>
          <div class="challenges">
            {project.details.challenges.map((c) => (
              <article class="challenge">
                <h3 class="challenge-title">{c.title}</h3>
                <p class="challenge-text">{c.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="block" data-reveal>
          <h2 class="block-title">{t.caseStack}</h2>
          <div class="stack">
            {project.details.stack.map((group) => (
              <div class="stack-group">
                <h3 class="stack-name">{group.name}</h3>
                <ul class="tech" role="list">
                  {group.items.map((item) => (
                    <li class="chip">{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      </div>

      <nav class="foot-nav" aria-label={t.caseBack}>
        <a class="foot-back" href={`${homePath(lang)}#projects`}>{t.caseBack}</a>
        {hasNext && (
          <a class="foot-next" href={projectPath(lang, next.slug)}>
            <span class="foot-next-label">{t.caseNext}</span>
            <span class="foot-next-title">
              {next.title}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        )}
      </nav>
    </div>
  </main>

  <dialog class="lightbox" id="case-lightbox" aria-label={t.caseGallery}>
    <div class="lightbox-stage">
      <header class="lightbox-bar">
        <div class="lightbox-meta">
          <span class="lightbox-counter" id="lb-counter">1 / 1</span>
          <span class="lightbox-title-text" id="lb-title"></span>
        </div>
        <button class="lightbox-close-btn" id="lb-close" type="button" aria-label="Close modal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </header>

      <div class="lightbox-center">
        <button class="lightbox-arrow lightbox-arrow--prev" id="lb-prev" type="button" aria-label="Previous screenshot">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="lightbox-view">
          <img class="lightbox-image" id="lb-img" src="" alt="" />
        </div>

        <button class="lightbox-arrow lightbox-arrow--next" id="lb-next" type="button" aria-label="Next screenshot">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <footer class="lightbox-footer">
        <p class="lightbox-caption-text" id="lb-caption"></p>
      </footer>
    </div>
  </dialog>

  <Footer dict={dict} />
</Base>

<script>
  // Elements for Hero Carousel
  const carousel = document.getElementById('case-carousel');
  const stage = document.getElementById('carousel-stage');
  const track = document.getElementById('carousel-track');
  const carouselSlides = Array.from(document.querySelectorAll<HTMLElement>('.carousel-slide'));
  const timelineSegs = Array.from(document.querySelectorAll<HTMLButtonElement>('.case-timeline-seg'));
  const carouselPrev = document.getElementById('carousel-prev');
  const carouselNext = document.getElementById('carousel-next');
  const carouselTitle = document.getElementById('carousel-slide-title');
  const carouselCaption = document.getElementById('carousel-slide-caption');
  const carouselCounter = document.getElementById('carousel-counter');
  const carouselZoomBtn = document.getElementById('carousel-zoom-btn');

  // Elements for Lightbox
  const lightbox = document.getElementById('case-lightbox') as HTMLDialogElement | null;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement | null;
  const lbTitle = document.getElementById('lb-title');
  const lbCaption = document.getElementById('lb-caption');
  const lbCounter = document.getElementById('lb-counter');
  const lbPrev = document.getElementById('lb-prev');
  const lbNext = document.getElementById('lb-next');
  const lbClose = document.getElementById('lb-close');

  const totalSlides = carouselSlides.length;
  let currentSlide = 0;
  let autoPlayTimer: number | null = null;
  let isDragging = false;
  let didDrag = false;
  let startX = 0;
  let deltaX = 0;

  function setCarouselSlide(index: number, animate = true) {
    if (totalSlides === 0 || !track) return;
    currentSlide = (index + totalSlides) % totalSlides;

    if (animate) {
      track.style.transition = 'transform 0.5s cubic-bezier(0.25, 1, 0.35, 1)';
    } else {
      track.style.transition = 'none';
    }
    track.style.transform = `translate3d(-${currentSlide * 100}%, 0, 0)`;

    carouselSlides.forEach((slide, i) => {
      slide.classList.toggle('is-active', i === currentSlide);
    });

    timelineSegs.forEach((seg, i) => {
      seg.classList.remove('is-active', 'is-done', 'is-paused');
      const fill = seg.querySelector<HTMLElement>('.case-timeline-fill');
      if (fill) fill.style.transition = '';
      if (i < currentSlide) {
        seg.classList.add('is-done');
      } else if (i === currentSlide) {
        void seg.offsetWidth;
        seg.classList.add('is-active');
        seg.setAttribute('aria-selected', 'true');
      } else {
        seg.setAttribute('aria-selected', 'false');
      }
    });

    const activeSlide = carouselSlides[currentSlide];
    if (activeSlide) {
      const title = activeSlide.dataset.galleryTitle || '';
      const caption = activeSlide.dataset.galleryCaption || '';
      if (carouselTitle && carouselTitle.textContent !== title) {
        carouselTitle.style.opacity = '0';
        setTimeout(() => {
          if (carouselTitle) {
            carouselTitle.textContent = title;
            carouselTitle.style.opacity = '1';
          }
        }, 120);
      }
      if (carouselCaption && carouselCaption.textContent !== caption) {
        carouselCaption.style.opacity = '0';
        setTimeout(() => {
          if (carouselCaption) {
            carouselCaption.textContent = caption;
            carouselCaption.style.opacity = '1';
          }
        }, 120);
      }
      if (carouselCounter) carouselCounter.textContent = `${currentSlide + 1} / ${totalSlides}`;
    }
  }

  function startAutoPlay() {
    stopAutoPlay();
    if (totalSlides <= 1) return;
    setCarouselSlide(currentSlide);
    autoPlayTimer = window.setInterval(() => {
      setCarouselSlide(currentSlide + 1);
    }, 5000);
  }

  function stopAutoPlay() {
    if (autoPlayTimer) {
      clearInterval(autoPlayTimer);
      autoPlayTimer = null;
    }
    const activeSeg = timelineSegs[currentSlide];
    if (activeSeg) {
      activeSeg.classList.add('is-paused');
    }
  }

  carouselPrev?.addEventListener('click', (e) => {
    e.stopPropagation();
    setCarouselSlide(currentSlide - 1);
    startAutoPlay();
  });

  carouselNext?.addEventListener('click', (e) => {
    e.stopPropagation();
    setCarouselSlide(currentSlide + 1);
    startAutoPlay();
  });

  timelineSegs.forEach((seg, idx) => {
    seg.addEventListener('click', (e) => {
      e.stopPropagation();
      setCarouselSlide(idx);
      startAutoPlay();
    });
  });

  // ── Physical Mouse & Touch Grab & Drag ──
  if (stage && track) {
    const onPointerDown = (clientX: number) => {
      isDragging = true;
      didDrag = false;
      startX = clientX;
      deltaX = 0;
      stopAutoPlay();
      stage.classList.add('is-dragging');
      track.style.transition = 'none';
    };

    const onPointerMove = (clientX: number) => {
      if (!isDragging) return;
      deltaX = clientX - startX;
      if (Math.abs(deltaX) > 6) {
        didDrag = true;
      }
      const width = stage.offsetWidth || 1;
      const pct = (deltaX / width) * 100;
      track.style.transform = `translate3d(calc(-${currentSlide * 100}% + ${pct}%), 0, 0)`;
    };

    const onPointerUp = () => {
      if (!isDragging) return;
      isDragging = false;
      stage.classList.remove('is-dragging');
      const width = stage.offsetWidth || 1;
      const threshold = width * 0.15;
      if (deltaX < -threshold) {
        setCarouselSlide(currentSlide + 1);
      } else if (deltaX > threshold) {
        setCarouselSlide(currentSlide - 1);
      } else {
        setCarouselSlide(currentSlide);
      }
      startAutoPlay();
    };

    // Mouse drag on stage
    stage.addEventListener('mousedown', (e) => {
      onPointerDown(e.clientX);
    });

    window.addEventListener('mousemove', (e) => {
      if (isDragging) onPointerMove(e.clientX);
    });

    window.addEventListener('mouseup', () => {
      if (isDragging) onPointerUp();
    });

    // Touch swipe on stage
    stage.addEventListener('touchstart', (e) => {
      onPointerDown(e.touches[0].clientX);
    }, { passive: true });

    carousel?.addEventListener('touchmove', (e) => {
      if (isDragging) onPointerMove(e.touches[0].clientX);
    }, { passive: true });

    carousel?.addEventListener('touchend', () => {
      if (isDragging) onPointerUp();
    }, { passive: true });

    carousel?.addEventListener('mouseenter', stopAutoPlay);
    carousel?.addEventListener('mouseleave', startAutoPlay);
  }

  startAutoPlay();

  // ── Lightbox Logic ──
  function showLightbox(index: number) {
    if (!totalSlides || !lightbox || !lbImg) return;
    currentSlide = (index + totalSlides) % totalSlides;
    setCarouselSlide(currentSlide);

    const activeSlide = carouselSlides[currentSlide];
    const src = activeSlide.dataset.galleryImage || '';
    const alt = activeSlide.dataset.galleryAlt || '';
    const title = activeSlide.dataset.galleryTitle || alt;
    const caption = activeSlide.dataset.galleryCaption || '';

    lbImg.src = src;
    lbImg.alt = alt;
    if (lbTitle) lbTitle.textContent = title;
    if (lbCaption) lbCaption.textContent = caption;
    if (lbCounter) lbCounter.textContent = `${currentSlide + 1} / ${totalSlides}`;

    if (lbPrev) lbPrev.style.display = totalSlides > 1 ? 'grid' : 'none';
    if (lbNext) lbNext.style.display = totalSlides > 1 ? 'grid' : 'none';
  }

  function openLightbox(index: number) {
    showLightbox(index);
    stopAutoPlay();
    lightbox?.showModal();
  }

  carouselSlides.forEach((slide, idx) => {
    slide.addEventListener('click', () => {
      if (!didDrag) {
        openLightbox(idx);
      }
      didDrag = false;
    });
    slide.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLightbox(idx);
      }
    });
  });

  carouselZoomBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    openLightbox(currentSlide);
  });

  lbPrev?.addEventListener('click', (e) => {
    e.stopPropagation();
    showLightbox(currentSlide - 1);
  });

  lbNext?.addEventListener('click', (e) => {
    e.stopPropagation();
    showLightbox(currentSlide + 1);
  });

  lbClose?.addEventListener('click', () => {
    lightbox?.close();
    startAutoPlay();
  });

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      lightbox.close();
      startAutoPlay();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (!lightbox?.open) return;
    if (e.key === 'ArrowLeft') {
      showLightbox(currentSlide - 1);
    } else if (e.key === 'ArrowRight') {
      showLightbox(currentSlide + 1);
    }
  });
</script>

<style>
  .case {
    padding-top: clamp(6.5rem, 12vh, 9rem);
    padding-bottom: var(--section-gap);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--muted);
    transition: color 0.2s, gap 0.25s var(--ease-out);
  }
  .back:hover {
    color: var(--accent);
    gap: 0.75rem;
  }

  .head {
    max-width: 48rem;
    margin-top: 2.5rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
  }
  .meta .dot {
    color: var(--line);
  }
  .wip {
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .title {
    margin-top: 1rem;
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .lede {
    margin-top: 1.4rem;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.6;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 2rem;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: 0.95rem;
    border-bottom: 1.5px solid var(--line);
    padding-bottom: 0.2rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ── Hero Carousel & Browser Shell ── */
  .case-carousel-wrapper {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .case-carousel {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    background: var(--bg-elev);
    display: flex;
    flex-direction: column;
    width: 100%;
    box-shadow: 0 16px 40px -16px rgba(0, 0, 0, 0.14);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .case-carousel:hover {
    border-color: var(--line);
    box-shadow: 0 24px 52px -20px rgba(0, 0, 0, 0.22);
  }

  /* ── Browser Mockup Header ── */
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1.1rem;
    background: rgba(25, 23, 18, 0.05);
    border-bottom: 1px solid var(--line-soft);
    position: relative;
    z-index: 2;
  }
  :root[data-theme='dark'] .browser-bar {
    background: rgba(255, 255, 255, 0.04);
  }
  .browser-dots {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .browser-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
