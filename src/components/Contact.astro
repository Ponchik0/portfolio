---
import SectionHead from './SectionHead.astro';
import { withBase } from '../i18n';
import type { Dictionary } from '../i18n/types';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const t = dict.contact;
---

<section class="section" id="contact">
  <div class="container">
    <SectionHead num="06" label={t.label} heading={t.heading} headingAccent={t.headingAccent} />

    <div class="grid">
      <div class="main" data-reveal>
        <p class="text">{t.text}</p>
        <a class="email" href={`mailto:${t.email}`}>
          {t.email}
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M6 18 18 6M9 6h9v9"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>

        <a class="cv-btn" href={withBase('/cv.pdf')} target="_blank" rel="noopener noreferrer">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          {t.cv}
        </a>
      </div>

      <ul class="socials" role="list">
        {
          t.socials.map((social, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
              <a class="social" href={social.url} target="_blank" rel="noopener noreferrer">
                <span class="social-name">{social.name}</span>
                <span class="social-handle">{social.handle}</span>
                <svg class="social-arrow" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="M4 12 12 4M6 4h6v6"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .text {
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.75;
    color: var(--muted);
    max-width: 30rem;
  }

  .email {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2rem;
    font-size: clamp(1.3rem, 3.4vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    border-bottom: 2px solid var(--line);
    padding-bottom: 0.35rem;
    transition: color 0.25s, border-color 0.25s;
    word-break: break-all;
  }

  .email:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .email svg {
    flex-shrink: 0;
    transition: transform 0.3s var(--ease-out);
  }

  .email:hover svg {
    transform: translate(3px, -3px);
  }

  .cv-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.6rem;
    padding: 0.7rem 1.3rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
    transition: border-color 0.2s, color 0.2s, transform 0.25s var(--ease-out);
  }

  .cv-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .cv-btn svg {
    color: var(--accent);
  }

  .socials {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .social {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1rem;
    padding-block: 1.15rem;
    border-top: 1px solid var(--line);
    transition: padding-left 0.3s var(--ease-out);
  }

  li:last-child .social {
    border-bottom: 1px solid var(--line);
  }

  .social:hover {
    padding-left: 0.5rem;
  }

  .social-name {
    font-weight: 800;
    font-size: 1.05rem;
  }

  .social-handle {
    font-size: 0.9rem;
    color: var(--muted);
    font-weight: 600;
  }

  .social-arrow {
    color: var(--muted);
    transition: color 0.2s, transform 0.3s var(--ease-out);
  }

  .social:hover .social-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  @media (max-width: 840px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
