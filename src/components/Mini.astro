---
import SectionHead from './SectionHead.astro';
import type { Dictionary } from '../i18n/types';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const t = dict.mini;
---

<section class="section" id="side-projects">
  <div class="container">
    <SectionHead num="03" label={t.label} heading={t.heading} headingAccent={t.headingAccent} />

    <div class="grid">
      {
        t.items.map((project, i) => {
          const Tag = project.url ? 'a' : 'div';
          const linkProps = project.url
            ? { href: project.url, target: '_blank', rel: 'noopener noreferrer' }
            : {};
          return (
            <Tag class="card" data-reveal style={`--reveal-delay: ${i * 0.08}s`} {...linkProps}>
              <div class="card__head">
                <h3 class="card__title">{project.title}</h3>
                {project.url && (
                  <svg class="card__arrow" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path
                      d="M4 12 12 4M6 4h6v6"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
              </div>
              <p class="card__desc">{project.description}</p>
              <ul class="tech" role="list">
                {project.tech.map((item) => (
                  <li class="chip">{item}</li>
                ))}
              </ul>
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 22rem));
    gap: clamp(1.2rem, 2.5vw, 1.6rem);
    justify-content: start;
  }

  .card {
    display: block;
    padding: clamp(1.5rem, 3vw, 1.9rem);
    border: 1px solid var(--line-soft);
    border-radius: 1.25rem;
    background: var(--bg-elev);
    transition: transform 0.5s var(--ease-out), border-color 0.3s;
  }

  a.card:hover {
    transform: translateY(-5px);
    border-color: var(--line);
  }

  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 0.7rem;
  }

  .card__title {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .card__arrow {
    color: var(--muted);
    flex: none;
    transition: color 0.2s, transform 0.3s var(--ease-out);
  }

  a.card:hover .card__arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .card__desc {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.2rem;
    padding: 0;
    list-style: none;
  }
</style>
