---
import type { Dictionary } from '../i18n/types';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<div class="preloader" id="preloader" aria-hidden="true">
  <div class="signature">
    <span class="name">{dict.hero.name}</span>
    <span class="line"><span /></span>
  </div>
</div>

<noscript><style>.preloader { display: none !important; }</style></noscript>

<script is:inline>
  (() => {
    const el = document.getElementById('preloader');
    if (!el) return;

    const notify = () => window.dispatchEvent(new Event('preloader:done'));
    let seen = false;
    try { seen = sessionStorage.getItem('intro-done') === '1'; } catch {}

    if (seen || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.remove();
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', notify, { once: true });
      } else notify();
      return;
    }

    const finish = () => {
      if (el.dataset.done) return;
      el.dataset.done = '1';
      try { sessionStorage.setItem('intro-done', '1'); } catch {}
      el.classList.add('leave');
      window.setTimeout(() => {
        el.remove();
        notify();
      }, 240);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', finish, { once: true });
    } else finish();
    window.setTimeout(finish, 1200);
  })();
</script>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    background: var(--bg);
    transition: opacity 0.24s ease;
  }

  .preloader.leave {
    opacity: 0;
    pointer-events: none;
  }

  .signature {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
  }

  .name {
    color: var(--ink);
    font-size: clamp(1.1rem, 4vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .line {
    width: 4rem;
    height: 2px;
    overflow: hidden;
    background: var(--line-soft);
  }

  .line > span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    animation: arrive 0.4s var(--ease-out) both;
  }

  @keyframes arrive {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader { transition: none; }
    .line > span { animation: none; }
  }
</style>
